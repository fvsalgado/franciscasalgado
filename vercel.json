{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.franciscasalgado.golf"
        }
      ],
      "destination": "https://franciscasalgado.golf/",
      "permanent": true
    },
    {
      "source": "/:caminho+",
      "has": [
        {
          "type": "host",
          "value": "www.franciscasalgado.golf"
        }
      ],
      "destination": "https://franciscasalgado.golf/:caminho+",
      "permanent": true
    },
    {
      "source": "/apoiar.html",
      "destination": "/parcerias.html",
      "permanent": true
    },
    {
      "source": "/apoiar",
      "destination": "/parcerias.html",
      "permanent": true
    },
    {
      "source": "/percurso.html",
      "destination": "/resultados.html",
      "permanent": true
    },
    {
      "source": "/en/percurso.html",
      "destination": "/en/resultados.html",
      "permanent": true
    },
    {
      "source": "/contacto.html",
      "destination": "/parcerias.html#contacto",
      "permanent": true
    },
    {
      "source": "/en/contacto.html",
      "destination": "/en/parcerias.html#contacto",
      "permanent": true
    },
    {
      "source": "/witb",
      "destination": "/witb.html",
      "permanent": true
    },
    {
      "source": "/en/witb",
      "destination": "/en/witb.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    }
  ]
}
